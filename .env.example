# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Backend REST API URL (PHP REST API, Node.js, Laravel, etc.)
# Examples: "http://localhost/shopeazy-api/api" or "http://localhost:8000/api"
# Leave empty or "/api" to use default local routing.
VITE_API_BASE_URL=""

# MySQL connection used by server.js
DB_ENABLED="true"
DB_REQUIRED="false"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="shopeazy_db"
DB_USER="root"
DB_PASSWORD=""
DB_CONNECTION_LIMIT="10"

# Server authentication settings
AUTH_SECRET="replace-with-a-long-random-secret"
FLW_SECRET_KEY=""
FLW_WEBHOOK_SECRET_HASH=""
# Required for MTN MoMo and Airtel Money because product prices are stored in USD.
# Set this to the current RWF amount for 1 USD; keep it updated as exchange rates change.
USD_TO_RWF_RATE=""
ADMIN_EMAIL="hakorimanajonathan42@shopeazy.com"
ADMIN_NAME="Jonathan Dev"
ADMIN_PASSWORD="replace-with-your-admin-password"
DEMO_USER_PASSWORD="password123"

